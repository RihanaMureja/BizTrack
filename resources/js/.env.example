# BizTrack Frontend — Environment Variables
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your own values below
# 3. Restart the dev server after changes

# Backend API base URL (no trailing slash)
VITE_API_URL=http://localhost:5000/api

# Chapa payment gateway public key
# Get yours at https://dashboard.chapa.co
VITE_CHAPA_PUBLIC_KEY=CHAPUBK-xxxxxxxxxxxxxxxxxxxx

# App display name
VITE_APP_NAME=BizTrack

# Environment: development | staging | production
VITE_APP_ENV=development
